#!/usr/bin/env python3
"""Identifiants S3 temporaires pour les snapshots quotidiens OpenAlex (offre payante).

Appelé par AWS CLI / boto3 via `credential_process` (profil « openalex », voir
docker/aws_config). La clé est lue dans la variable d'environnement
OPENALEX_API_KEY au moment de l'appel : elle n'est jamais écrite dans l'image.
"""
import os
import sys
import urllib.error
import urllib.request

key = os.environ.get("OPENALEX_API_KEY")
if not key:
    sys.exit("OPENALEX_API_KEY absente de l'environnement")
req = urllib.request.Request(
    "https://api.openalex.org/snapshots/credentials?api_key=" + key, method="POST")
try:
    with urllib.request.urlopen(req) as r:
        print(r.read().decode())
except urllib.error.HTTPError as e:      # message sans l'URL, qui contient la clé
    sys.exit(f"OpenAlex a refusé la demande d'identifiants (HTTP {e.code})")
